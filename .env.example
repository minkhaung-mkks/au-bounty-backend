# AU Bounty backend environment. Every value has a dev default so compose
# works with zero secrets; see docs/plan/implementation-guide.md.

DATABASE_URL="postgresql://aubounty:aubounty@localhost:5433/aubounty?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://localhost:8080"

# --- auth -----------------------------------------------------------------
# Microsoft Entra app registration (confidential client). A missing
# ENTRA_CLIENT_SECRET disables login: /auth/login -> 503, /meta configured=false.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Redirect URI base to register in Entra: <base>/auth/callback
AUTH_CALLBACK_BASE=http://localhost:4000/aubounty/api
# Signs the 1h aubounty_token session cookie (HS256). Random in dev, e.g.
#   openssl rand -base64 48
JWT_SECRET=
COOKIE_SECURE=false
# Set when the SPA runs on a different origin than the API (dev vite server);
# the post-login redirect prepends it to the sanitized returnTo path.
APP_ORIGIN=
# Dev sign-in picker + /dev routes. Must be 0/absent in prod.
DEV_AUTH=1

# --- files (D5) ------------------------------------------------------------
# Any S3-compatible store. Dev default is the compose MinIO service; prod
# points these at real credentials. S3_FORCE_PATH_STYLE=true is required for
# MinIO. An empty S3_BUCKET disables presigning (503) but never crashes boot.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=aubounty
S3_ACCESS_KEY=aubounty
S3_SECRET_KEY=aubounty
S3_FORCE_PATH_STYLE=true
# Upload ceiling enforced at POST /files/presign, in megabytes.
MAX_UPLOAD_MB=10

# --- peer API + emergency button (D6) ---------------------------------------
# Inbound: the x-api-key the partner (SL Systems) must present on
# POST /peer/emergency-tasks. Unset -> the endpoint answers 503.
PEER_INBOUND_API_KEY=
# Outbound: base URL emergency alerts are forwarded to (the peer-mock service
# in dev, the real partner later). Empty disables forwarding entirely.
PEER_OUTBOUND_URL=http://localhost:7000
PEER_OUTBOUND_API_KEY=
# Minutes a student must wait between emergency presses.
ALERT_COOLDOWN_MIN=5

# --- integrations (D8-D11) --------------------------------------------------
# Email transport: `console` logs every send (dev/demo), `resend` POSTs to
# https://api.resend.com. Both write the EmailOutbox row; failures stay queued
# and the mail scheduler retries them.
MAIL_TRANSPORT=console
RESEND_API_KEY=
MAIL_FROM=
# Google Maps: geocoding of location names + static map thumbnails. Without a
# key, task creation falls back to manual lat/lng and no mapUrl is derived.
GOOGLE_MAPS_KEY=
# Google Cloud Translation v2. Without a key, POST /tasks/:id/translate is an
# identity fallback and /meta reports translation: false.
GOOGLE_TRANSLATE_KEY=
# Open-Meteo needs no key; these pin the campus point the weather chip shows.
WEATHER_LAT=13.6146
WEATHER_LON=100.7121
WEATHER_LABEL=Bang Na
