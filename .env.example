# AU Bounty backend environment. Every value has a dev default so compose
# works with zero secrets; see docs/plan/implementation-guide.md.

DATABASE_URL="postgresql://aubounty:aubounty@localhost:5433/aubounty?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://localhost:8080"

# --- auth -----------------------------------------------------------------
# Microsoft Entra app registration (confidential client). A missing
# ENTRA_CLIENT_SECRET disables login: /auth/login -> 503, /meta configured=false.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Redirect URI base to register in Entra: <base>/auth/callback
AUTH_CALLBACK_BASE=http://localhost:4000/aubounty/api
# Signs the 1h aubounty_token session cookie (HS256). Random in dev, e.g.
#   openssl rand -base64 48
JWT_SECRET=
COOKIE_SECURE=false
# Set when the SPA runs on a different origin than the API (dev vite server);
# the post-login redirect prepends it to the sanitized returnTo path.
APP_ORIGIN=
# Dev sign-in picker + /dev routes. Must be 0/absent in prod.
DEV_AUTH=1  # trusted-dev-only, must be unset/0 wherever non-participants can reach the API

# --- admin console sign-in -------------------------------------------------
# The admin console has its own password form at /admin-login (unlinked; reached
# by typing the URL), backed by POST /auth/admin/login. prisma/seedAdmins.js
# runs on every container boot and makes sure these accounts exist.
#
# CHANGE THIS BEFORE ANY REAL DEPLOYMENT. The default below is the demo value
# and is public knowledge; anyone who reaches the URL with it gets full
# moderation rights over every task, user and organization.
ADMIN_SEED_PASSWORD=admin123
# Comma-separated, in order, overriding admin.one/two/three@au.edu.
ADMIN_SEED_EMAILS=
# 1 re-hashes the password on every boot, undoing any change made since. Leave
# unset so the seed only fills a password that is missing.
ADMIN_SEED_RESET_PASSWORD=0
# Skip the admin seed entirely (accounts already provisioned some other way).
SEED_ADMINS=1
# Number of reverse proxies in front of the API, or a value Express understands
# ('loopback', a subnet). Without it every request behind nginx shares one
# source address and the login throttle counts them all together.
TRUST_PROXY=

# --- files (D5) ------------------------------------------------------------
# Any S3-compatible store. Dev default is the compose MinIO service; prod
# points these at real credentials. S3_FORCE_PATH_STYLE=true is required for
# MinIO. An empty S3_BUCKET disables presigning (503) but never crashes boot.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=aubounty
S3_ACCESS_KEY=aubounty
S3_SECRET_KEY=aubounty
S3_FORCE_PATH_STYLE=true
# Upload ceiling enforced at POST /files/presign, in megabytes.
MAX_UPLOAD_MB=10

# --- integrations (D8-D11) --------------------------------------------------
# Email transport: `console` logs every send (dev/demo), `resend` POSTs to
# https://api.resend.com. Both write the EmailOutbox row; failures stay queued
# and the mail scheduler retries them.
MAIL_TRANSPORT=console
RESEND_API_KEY=
MAIL_FROM=
# Google Maps: geocoding of location names + static map thumbnails. Without a
# key, task creation falls back to manual lat/lng and no mapUrl is derived.
GOOGLE_MAPS_KEY=
# Google Cloud Translation v2. Without a key, POST /tasks/:id/translate is an
# identity fallback and /meta reports translation: false.
GOOGLE_TRANSLATE_KEY=
# Open-Meteo needs no key; these pin the campus point the weather chip shows.
WEATHER_LAT=13.6146
WEATHER_LON=100.7121
WEATHER_LABEL=Bang Na

# --- secrets provider ---------------------------------------------------------
# `env` (default): everything above comes from the environment.
# `keyvault`: on boot the app fetches ENTRA_CLIENT_SECRET, JWT_SECRET,
# RESEND_API_KEY, GOOGLE_MAPS_KEY, GOOGLE_TRANSLATE_KEY from
# Azure Key Vault (names with dashes, see src/lib/secrets.js) and overrides
# whatever the environment holds. Boot fails closed if the vault is
# unreachable. Authentication is DefaultAzureCredential: the AZURE_* service
# principal below when present, managed identity otherwise.
SECRETS_PROVIDER=env
# KEY_VAULT_URL=https://<vault-name>.vault.azure.net/
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
